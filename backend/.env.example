# Cosmos DB Configuration
COSMOS_DB_CONNECTION_STRING=AccountEndpoint=https://barebonde.documents.azure.com:443/;AccountKey=YOUR_KEY_HERE;
COSMOS_DB_DATABASE_ID=barebonde

# Email (Plunk - https://plunk.com)
# Get keys from https://plunk.com/dashboard/api-keys (in your project)
# Secret key (sk_) - For server-side: send email, manage contacts, campaigns
# Public key (pk_) - For client-side: event tracking only (not used in MVP)
PLUNK_SECRET_API_KEY=sk_your_secret_key_from_plunk_dashboard
PLUNK_PUBLIC_API_KEY=pk_your_public_key_from_plunk_dashboard

# JWT (still used for API tokens if needed)
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256

# API
API_PORT=8000
API_HOST=0.0.0.0
ENV=development
FRONTEND_URL=http://localhost:3000
