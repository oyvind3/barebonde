# Cosmos DB Configuration
COSMOS_DB_CONNECTION_STRING=AccountEndpoint=https://barebonde.documents.azure.com:443/;AccountKey=YOUR_KEY_HERE;
COSMOS_DB_DATABASE_ID=barebonde

# Email (Plunk - https://plunk.com)
# Get keys from https://plunk.com/dashboard/api-keys (in your project)
# A secret key (sk_) is required to send email. Never use a public pk_ key here.
PLUNK_SECRET_API_KEY=sk_your_secret_key_from_plunk_dashboard
# This sender must use a domain verified in Plunk.
PLUNK_FROM_EMAIL=notifications@your-verified-domain.example
PLUNK_FROM_NAME=Barebonde
# Optional. Defaults to https://next-api.useplunk.com/v1/send.
PLUNK_API_URL=https://next-api.useplunk.com/v1/send

# JWT (still used for API tokens if needed)
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Google OAuth (Sign in with Google)
# Get from Google Cloud Console: https://console.cloud.google.com/
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URIs:
#    - http://localhost:3000 (local dev)
#    - http://localhost:8000 (backend)
#    - https://salmon-ocean-076260203.7.azurestaticapps.net (production JavaScript origin)
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# API
API_PORT=8000
API_HOST=0.0.0.0
ENV=development
FRONTEND_URL=http://localhost:3000
