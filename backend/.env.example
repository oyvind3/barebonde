# Database
DATABASE_URL=postgresql://barebonde:password@localhost:5432/barebonde

# ID-porten (OAuth2)
IDPORTEN_CLIENT_ID=your_client_id
IDPORTEN_CLIENT_SECRET=your_client_secret
IDPORTEN_DISCOVERY_URL=https://oidc.difi.no/idporten-oidc/
IDPORTEN_REDIRECT_URL=http://localhost:3000/api/auth/callback

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# API
API_PORT=8000
API_HOST=0.0.0.0
ENV=development
