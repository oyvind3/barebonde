# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth (Sign in with Google)
# IMPORTANT: Only expose CLIENT_ID to frontend, NEVER the CLIENT_SECRET
# Get from Google Cloud Console: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# Better Auth Configuration (https://dash.better-auth.com)
NEXT_PUBLIC_BETTER_AUTH_URL=https://your-better-auth-project.better-auth.com
